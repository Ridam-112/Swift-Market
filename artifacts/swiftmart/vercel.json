{
  "trailingSlash": false,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://swift-market-api-server-6w3x.vercel.app/api/$1"
    },
    {
      "src": "/api",
      "dest": "https://swift-market-api-server-6w3x.vercel.app/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}