{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://swift-market-api-server-6w3x.vercel.app/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://swift-market-api-server-6w3x.vercel.app/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}